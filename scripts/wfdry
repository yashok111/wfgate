#!/usr/bin/env node
// wfdry — dynamic dry runner for Claude Code Workflow scripts.
//
// The static checker reads these scripts as text. This one EXECUTES the body
// with every orchestration hook stubbed, so it walks paths a parse cannot
// reach: a template literal that only composes on the failure branch, a field
// dereferenced on a result that is null in one mode, a gate accounted for on a
// branch that was never taken. A parse is not an execution.
//
// Usage:
//   wfdry <script.js>                  every mode
//   wfdry <script.js> --mode clean     one mode
//   wfdry <script.js> --dead a,b       kill these labels in every mode
//   wfdry <script.js> --budget 500000  run with a token target set
//   wfdry <script.js> --quiet          verdicts only, no per-mode detail
//
// Modes, and what each is for:
//   clean         nothing goes wrong. THE ONE THAT MATTERS MOST — reviewers read
//                 the failure branches, because that is where the risk looks like
//                 it lives, so the defects that survive a gate live here.
//   blockers      every gate returns blockers; walks the fix and delta rounds.
//   acceptfail    the acceptance step observes a failure; walks the closeout path.
//   unfixed       a fix agent reports it could not close something.
//   throw-serial  the first spawn throws; walks the early-abort exit.
//   dead-reviews  every review/fix/closeout agent returns null; walks the
//                 unreviewed-gate accounting, which is the check that most often
//                 reads a dead agent's fields.
//
// THE FIXTURE CONTRACT. A stub cannot invent a report shape, so it derives one
// from the `schema` the script hands each call — that schema IS the contract —
// plus these well-known field names, which carry a mode-dependent value:
//   fail arrays : blockers majors failures unfixed openBlockers concerns dead
//                 unverifiedGates  → empty in `clean`, one element otherwise
//   good arrays : anything else (files, checks, seams, fixed, observations …)
//                 → always one element, so consumers have something to read
//   booleans    : a name reading as a failure (failed, broken, vacuous, missing)
//                 is false in `clean`; every other boolean is true in `clean`.
//                 `passed`/`ok`/`green` invert in `acceptfail`.
// A script whose report fields fall outside that set still runs — it just gets
// placeholder strings, which is enough for control flow.
//
// Exit 1 if any mode throws, or if a mode's return value is not an object.

'use strict'

const fs = require('fs')

const argv = process.argv.slice(2)
const file = argv.find((a) => !a.startsWith('--'))
const flag = (name, dflt) => {
  const i = argv.indexOf(`--${name}`)
  return i === -1 ? dflt : argv[i + 1]
}
if (!file) {
  console.error('usage: wfdry <workflow-script.js> [--mode M] [--dead a,b] [--budget N] [--quiet]')
  process.exit(2)
}
const QUIET = argv.includes('--quiet')
const DEAD = new Set((flag('dead', '') || '').split(',').filter(Boolean))
const BUDGET = flag('budget', null) === null ? null : Number(flag('budget', null))
const ALL_MODES = ['clean', 'blockers', 'acceptfail', 'unfixed', 'throw-serial', 'dead-reviews']
const MODES = flag('mode', null) ? [flag('mode', null)] : ALL_MODES

// The meta binding is STRIPPED, not renamed to a live one: the real harness
// parses `export const meta` out before the body runs, so a body that touches
// `meta` must die here the way it dies at launch. The renamed binding this
// line used to leave in scope produced a measured false green — six modes,
// six rounds, over a guard reading meta.phases — and the launch died in 29 ms
// (P2e, wfgate/FEEDBACK-p2e.md §8).
const src = fs.readFileSync(file, 'utf8').replace(/^export const meta/m, 'const __wfdry_meta_stripped')

const FAIL_ARRAYS = new Set([
  'blockers', 'majors', 'failures', 'unfixed', 'openblockers', 'concerns', 'dead',
  'unverifiedgates', 'violations', 'gaps', 'risks',
])
const FAIL_BOOLS = /fail|broken|vacuous|missing|stale|dead|unreviewed/i
const PASS_BOOLS = /^(passed|ok|green|clean|verified|proven)$/i

function synth(schema, mode, label, depth = 0) {
  if (!schema || depth > 6) return {}
  if (schema.type === 'array') return arrayOf('', schema, mode, label, depth)
  const out = {}
  for (const [k, v] of Object.entries(schema.properties || {})) out[k] = value(k, v, mode, label, depth)
  return out
}

function arrayOf(name, v, mode, label, depth) {
  const isFail = FAIL_ARRAYS.has(name.toLowerCase())
  let n = isFail ? (mode === 'clean' ? 0 : 1) : 1
  if (name.toLowerCase() === 'failures') n = mode === 'acceptfail' ? 1 : 0
  if (name.toLowerCase() === 'unfixed') n = mode === 'unfixed' ? 1 : 0
  const items = v.items || { type: 'string' }
  return Array.from({ length: n }, () =>
    items.type === 'object' ? synth(items, mode, label, depth + 1) : `<${name || 'item'} from ${label}>`)
}

function value(name, v, mode, label, depth) {
  switch (v && v.type) {
    case 'array': return arrayOf(name, v, mode, label, depth)
    case 'object': return synth(v, mode, label, depth + 1)
    case 'integer':
    case 'number': return 1
    case 'boolean':
      if (PASS_BOOLS.test(name)) return mode !== 'acceptfail'
      if (FAIL_BOOLS.test(name)) return mode !== 'clean'
      return mode === 'clean'
    default: return `<${name} from ${label}>`
  }
}

async function run(mode) {
  const calls = []
  const phases = []
  const logs = []
  const violations = []
  let spawned = 0

  const agent = async (prompt, opts = {}) => {
    spawned++
    const label = opts.label || `agent@${spawned}`
    calls.push(`${label} [${opts.model || 'NO MODEL'}]`)
    // A runtime restatement of three static checks — free once the harness runs,
    // and it catches a prompt composed to `undefined` on one branch only.
    //
    // These are recorded OUT OF BAND and only then thrown. The guide requires a
    // script to wrap the spawn call and turn a throw into null, so a stub that
    // signals by throwing is signalling into the one mechanism guaranteed to
    // swallow it: the defect is recorded as a dead agent, the mode completes,
    // and the runner reports OK. Measured on a real script — three injected
    // defects, three green runs. The violation list is what makes the mode fail.
    const bad = (msg) => { violations.push(`${label}: ${msg}`); throw new Error(msg) }
    if (typeof prompt !== 'string') bad(`prompt is ${typeof prompt}, not a string`)
    if (!prompt.trim()) bad('empty prompt')
    if (!opts.schema) bad('no schema')
    if (!opts.model) bad('no model')
    if (DEAD.has(label)) throw new Error(`stubbed death of ${label}`)
    if (mode === 'throw-serial' && spawned === 1) throw new Error(`stubbed throw at the first spawn`)
    if (mode === 'dead-reviews' && /review|fix|closeout|verify|accept/i.test(label)) return null
    return synth(opts.schema, mode, label)
  }

  const parallel = async (thunks) => Promise.all(thunks.map((t) => Promise.resolve().then(t).catch(() => null)))
  const pipeline = async (items, ...stages) => {
    const one = async (item, i) => {
      let acc = item
      for (const st of stages) acc = await st(acc, item, i)
      return acc
    }
    return Promise.all(items.map((it, i) => one(it, i).catch(() => null)))
  }
  const budget = {
    total: BUDGET,
    spent: () => spawned * 20000,
    remaining: () => (BUDGET === null ? Infinity : Math.max(0, BUDGET - spawned * 20000)),
  }

  const AsyncFunction = Object.getPrototypeOf(async function () {}).constructor
  const body = new AsyncFunction('agent', 'parallel', 'pipeline', 'phase', 'log', 'args', 'budget', src)
  const out = await body(agent, parallel, pipeline, (t) => phases.push(t), (m) => logs.push(String(m)), undefined, budget)
  return { out, calls, phases, logs, spawned, violations }
}

// Wrapped in a main(): this file uses require(), so a top-level await would make
// the module format ambiguous and Node refuses to load it at all.
async function main() {
let failed = 0
for (const mode of MODES) {
  try {
    const r = await run(mode)
    if (r.violations.length) {
      failed++
      console.log(`\n=== ${mode}: ${r.violations.length} VIOLATION(S) — the script's spawn wrapper swallowed these ===`)
      for (const v of r.violations) console.log('  ' + v)
      continue
    }
    const ok = r.out && typeof r.out === 'object'
    if (!ok) { failed++; console.log(`\n=== ${mode}: BAD RETURN (${typeof r.out}) after ${r.spawned} agents ===`); continue }
    console.log(`\n=== ${mode}: OK — ${r.spawned} agents, ${r.phases.length} phases ===`)
    if (!QUIET) {
      console.log('  phases:', r.phases.join(' | ') || '(none)')
      console.log('  agents:', r.calls.join(' ') || '(none)')
      // Print the whole return value: the verdict fields are what a reader is
      // checking, and a summary of them would hide the case this tool exists for.
      console.log('  return:', JSON.stringify(r.out, null, 1).split('\n').map((l) => '  ' + l).join('\n').trim())
    }
  } catch (e) {
    failed++
    console.log(`\n=== ${mode}: THREW ===`)
    console.log((e && e.stack ? e.stack : String(e)).split('\n').slice(0, 8).join('\n'))
  }
}
console.log(`\n${file}: ${MODES.length - failed}/${MODES.length} modes completed`)
process.exit(failed ? 1 : 0)
}

main()

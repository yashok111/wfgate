#!/usr/bin/env node
// wfcheck — static checker for Claude Code Workflow scripts.
//
// The pre-flight gate is expensive (opus reviewers, minutes per round). A large
// share of what it found across five multi-agent phases was mechanical: a report
// field named in a prompt that the agent's schema does not declare, a contract
// block handed to the writer but not to its caller, two agents owning one file,
// `git add -N X && git diff` (which hides the diff entirely), `gofmt -l X &&`
// (which never fires). Those are cheaper to catch here than with a frontier
// model, and catching them here means the reviewers spend their round on the
// things only a reader can see.
//
// Usage:
//   wfcheck <script.js>            check
//   wfcheck --freeze <script.js>   copy to .wf/gate/<sha8>-<name> and print the path
//                                  (hand THAT to the gate reviewers so their line
//                                   numbers cannot drift while you apply fixes)
//
// The guide requires a script to wrap the spawn call (an unhandled throw at a
// serial step aborts the run), and the canonical name for that wrapper is
// `spawn`. That is not cosmetic: every check past the inventory reads the list
// of call sites, so a wrapper under an unrecognised name silently disables all
// of them and this file exits 0. The plausibility check in section 5 exists to
// make that state loud instead of clean.
//
// Exit 1 on any ERROR, 0 otherwise. Heuristic by design: it reads these scripts
// as text, not as an AST, so it errs toward reporting. Everything it prints
// names a line.

'use strict'

const fs = require('fs')
const path = require('path')
const crypto = require('crypto')
const { execFileSync } = require('child_process')
const os = require('os')

// --------------------------------------------------------------- scanning --

// blankOut returns a copy of src with the CONTENTS of strings, template
// literals, comments and regex literals replaced by spaces (newlines kept), so
// that brace matching and structural regexes cannot be derailed by an
// apostrophe in prose or a brace inside a prompt. It also returns the spans of
// every template literal, which is how prompts are located.
function blankOut(src) {
  const out = Buffer.from(src, 'utf8').toString('utf8').split('')
  const templates = []
  let i = 0
  const n = src.length
  let prevMeaningful = ''
  const tplStack = []

  const blank = (from, to) => {
    for (let k = from; k < to; k++) if (out[k] !== '\n') out[k] = ' '
  }

  while (i < n) {
    const c = src[i]
    const c2 = src[i + 1]

    if (c === '/' && c2 === '/') {
      const end = src.indexOf('\n', i)
      blank(i, end === -1 ? n : end)
      i = end === -1 ? n : end
      continue
    }
    if (c === '/' && c2 === '*') {
      const end = src.indexOf('*/', i + 2)
      blank(i, end === -1 ? n : end + 2)
      i = end === -1 ? n : end + 2
      continue
    }
    if (c === "'" || c === '"') {
      let j = i + 1
      while (j < n && src[j] !== c) {
        if (src[j] === '\\') j++
        j++
      }
      blank(i + 1, Math.min(j, n))
      i = Math.min(j + 1, n)
      prevMeaningful = 'str'
      continue
    }
    if (c === '`') {
      // Template literal: blank everything except the ${ } interpolations,
      // which are real code and may themselves contain templates.
      const start = i
      let j = i + 1
      const interps = [] // [from,to) ranges of ${...} that must stay visible as code
      while (j < n) {
        if (src[j] === '\\') { j += 2; continue }
        if (src[j] === '`') break
        if (src[j] === '$' && src[j + 1] === '{') {
          let braces = 1
          let k = j + 2
          while (k < n && braces > 0) {
            if (src[k] === '{') braces++
            else if (src[k] === '}') braces--
            else if (src[k] === '`') {
              // nested template inside an interpolation: skip it wholesale
              let m = k + 1
              while (m < n && src[m] !== '`') { if (src[m] === '\\') m++; m++ }
              k = m
            }
            k++
          }
          interps.push([j, Math.min(k, n)])
          j = k
          continue
        }
        j++
      }
      templates.push({ start, end: Math.min(j + 1, n) })
      // Blank the prose, KEEP the ${...} interpolations: they are real code and
      // are how every "is this const actually used" check sees a use.
      for (let k = start + 1; k < Math.min(j, n); k++) {
        if (out[k] === '\n') continue
        if (interps.some(([a, b]) => k >= a && k < b)) continue
        out[k] = ' '
      }
      i = Math.min(j + 1, n)
      prevMeaningful = 'str'
      continue
    }
    if (c === '/' && /[(,=:[!&|?{};+\n]/.test(prevMeaningful || '\n')) {
      // regex literal
      let j = i + 1
      let inClass = false
      while (j < n) {
        if (src[j] === '\\') { j += 2; continue }
        if (src[j] === '[') inClass = true
        else if (src[j] === ']') inClass = false
        else if (src[j] === '/' && !inClass) break
        else if (src[j] === '\n') break
        j++
      }
      blank(i + 1, Math.min(j, n))
      i = Math.min(j + 1, n)
      prevMeaningful = 'str'
      continue
    }
    if (!/\s/.test(c)) prevMeaningful = c
    i++
  }
  return { code: out.join(''), templates }
}

function matchPair(code, openIdx, open, close) {
  let depth = 0
  for (let i = openIdx; i < code.length; i++) {
    if (code[i] === open) depth++
    else if (code[i] === close) {
      depth--
      if (depth === 0) return i
    }
  }
  return -1
}

const lineOf = (src, idx) => src.slice(0, idx).split('\n').length

// ---------------------------------------------------------------- reports --

const findings = []
const report = (level, line, msg) => findings.push({ level, line, msg })
const ERROR = 'ERROR'
const WARN = 'WARN'
const INFO = 'INFO'

// ------------------------------------------------------------------ input --

const argv = process.argv.slice(2)
const freeze = argv.includes('--freeze')
const file = argv.find((a) => !a.startsWith('--'))
if (!file) {
  console.error('usage: wfcheck [--freeze] <workflow-script.js>')
  process.exit(2)
}
const src = fs.readFileSync(file, 'utf8')
const { code, templates } = blankOut(src)

if (freeze) {
  const sha = crypto.createHash('sha256').update(src).digest('hex').slice(0, 8)
  const dir = path.join(process.cwd(), '.wf', 'gate')
  fs.mkdirSync(dir, { recursive: true })
  const dest = path.join(dir, `${sha}-${path.basename(file)}`)
  fs.writeFileSync(dest, src)
  console.log(dest)
}

// --------------------------------------------------------------- 1. syntax --

{
  const metaIdx = code.indexOf('export const meta')
  let bodyStart = 0
  if (metaIdx !== -1) {
    const brace = code.indexOf('{', metaIdx)
    const end = matchPair(code, brace, '{', '}')
    bodyStart = end + 1
  } else {
    report(ERROR, 1, 'no `export const meta = {...}` — every workflow script must begin with one')
  }
  const tmp = path.join(fs.mkdtempSync(path.join(os.tmpdir(), 'wfcheck-')), 'body.mjs')
  fs.writeFileSync(tmp, `async function __wf(){\n${src.slice(bodyStart)}\n}\n`)
  try {
    execFileSync(process.execPath, ['--check', tmp], { stdio: 'pipe' })
  } catch (e) {
    const msg = (e.stderr || Buffer.from('')).toString().split('\n').slice(0, 4).join(' | ')
    report(ERROR, 1, `body does not parse: ${msg}`)
  }
  if (metaIdx !== -1) {
    const brace = code.indexOf('{', metaIdx)
    const end = matchPair(code, brace, '{', '}')
    const metaSrc = src.slice(brace, end + 1)
    if (metaSrc.includes('${')) report(ERROR, lineOf(src, brace), 'meta contains a template interpolation — it must be a PURE literal')
    if (/`/.test(metaSrc)) report(WARN, lineOf(src, brace), 'meta contains a backtick — keep it to plain string literals')
  }
}

// ------------------------------------------------- 2. meta phases vs phase() --

const metaTitles = []
{
  const metaIdx = code.indexOf('export const meta')
  if (metaIdx !== -1) {
    const brace = code.indexOf('{', metaIdx)
    const end = matchPair(code, brace, '{', '}')
    const metaSrc = src.slice(brace, end + 1)
    for (const m of metaSrc.matchAll(/title:\s*'([^']+)'/g)) metaTitles.push(m[1])
  }
}
const phaseCalls = []
for (const m of code.matchAll(/^\s*phase\('([^']*)'\)/gm)) {
  // The blanked copy keeps quotes but not their contents, so read the title
  // from the original at the same offset.
  const orig = src.slice(m.index, m.index + m[0].length).match(/phase\('([^']+)'\)/)
  if (orig) phaseCalls.push({ title: orig[1], idx: m.index })
}
{
  const callTitles = phaseCalls.map((p) => p.title)
  if (metaTitles.length && callTitles.length) {
    if (metaTitles.join('|') !== callTitles.join('|')) {
      const missing = callTitles.filter((t) => !metaTitles.includes(t))
      const extra = metaTitles.filter((t) => !callTitles.includes(t))
      if (missing.length) report(ERROR, 1, `phase() titles with no meta.phases entry: ${missing.join(', ')}`)
      if (extra.length) report(WARN, 1, `meta.phases entries with no phase() call: ${extra.join(', ')}`)
      if (!missing.length && !extra.length) report(WARN, 1, `meta.phases and phase() calls have the same titles in a DIFFERENT order — meta: ${metaTitles.join(' > ')} / calls: ${callTitles.join(' > ')}`)
    }
  }
}

// -------------------------------------------------------- 3. const inventory --

const consts = new Map() // name -> {start, end, kind}
for (const m of code.matchAll(/^const\s+([A-Za-z_$][\w$]*)\s*=/gm)) {
  const name = m[1]
  let i = m.index + m[0].length
  while (i < code.length && /\s/.test(code[i])) i++
  let end
  let kind = 'other'
  if (src[i] === '`') {
    const tpl = templates.find((t) => t.start === i)
    end = tpl ? tpl.end : code.indexOf('\n', i)
    kind = 'text'
  } else if (code[i] === '{') {
    end = matchPair(code, i, '{', '}') + 1
    kind = 'object'
  } else if (code[i] === '(') {
    const close = matchPair(code, i, '(', ')')
    const arrow = code.indexOf('=>', close)
    let j = arrow + 2
    while (j < code.length && /\s/.test(code[j])) j++
    if (code[j] === '{') end = matchPair(code, j, '{', '}') + 1
    else if (src[j] === '`') { const tpl = templates.find((t) => t.start === j); end = tpl ? tpl.end : code.indexOf('\n', j) }
    else end = code.indexOf('\n', j)
    kind = 'fn'
  } else {
    end = code.indexOf('\n', i)
  }
  consts.set(name, { start: m.index, valueStart: i, end: end === -1 ? code.length : end, kind })
}

// unused top-level consts
for (const [name, info] of consts) {
  const uses = (code.match(new RegExp(`\\b${name.replace(/\$/g, '\\$')}\\b`, 'g')) || []).length
  if (uses <= 1) report(WARN, lineOf(src, info.start), `const ${name} is declared but never used`)
}

// contract blocks handed to only one agent
for (const [name, info] of consts) {
  if (!/^(SIG|CTX)_/.test(name)) continue
  const interp = (code.match(new RegExp(`\\$\\{${name}\\}`, 'g')) || []).length
  if (interp === 0) report(ERROR, lineOf(src, info.start), `${name} is defined but interpolated into NO prompt`)
  else if (interp === 1 && name.startsWith('SIG_')) {
    report(WARN, lineOf(src, info.start), `${name} is interpolated into exactly ONE prompt — a signature block must reach the writer AND every caller; one that reached neither of its callers shipped a contract two agents then guessed differently`)
  }
}

// ---------------------------------------------------------- 4. schema shapes --

const schemaProps = new Map() // const name -> Set(propnames)
for (const [name, info] of consts) {
  if (info.kind !== 'object') continue
  const body = code.slice(info.valueStart, info.end)
  const pIdx = body.indexOf('properties:')
  if (pIdx === -1) continue
  const brace = body.indexOf('{', pIdx)
  const end = matchPair(body, brace, '{', '}')
  const inner = body.slice(brace + 1, end)
  const props = new Set()
  let depth = 0
  for (const line of inner.split('\n')) {
    const trimmed = line.trim()
    if (depth === 0) {
      const m = trimmed.match(/^([A-Za-z_][\w]*)\s*:/)
      if (m) props.add(m[1])
    }
    for (const ch of line) {
      if (ch === '{' || ch === '[') depth++
      else if (ch === '}' || ch === ']') depth--
    }
  }
  if (props.size) schemaProps.set(name, props)
}
const allSchemaFields = new Set()
for (const s of schemaProps.values()) for (const p of s) allSchemaFields.add(p)

// ----------------------------------------------------------- 5. agent calls --

// A script may wrap agent() — the common one turns a thrown "StructuredOutput
// retry cap exceeded" into the null the rest of the script already handles, so
// one dead subagent does not abort a run whose earlier phases are already on
// disk. Recognise the wrappers as call sites, and skip the ONE forwarding call
// inside the wrapper itself: it passes variables, not a prompt, and flagging it
// for "no model:" is noise that trains a reader to ignore real errors.
//
// `spawn` is the CANONICAL wrapper name and the guide requires it. The list
// below is not the safeguard — a list of names is exactly what failed: a script
// named its wrapper a fourth thing, this file matched one call site out of
// nineteen, every check downstream of the inventory passed over an empty set,
// and the run exited 0. The safeguard is the plausibility check after the loop.
const agents = []
let forwarders = 0
for (const m of code.matchAll(/\b(?:agent|agentSafe|safeAgent|spawn)\(/g)) {
  const open = m.index + m[0].length - 1
  const close = matchPair(code, open, '(', ')')
  if (close === -1) continue
  const callCode = code.slice(open, close + 1)
  const callSrc = src.slice(open, close + 1)
  // A wrapped call's prompt is usually COMPOSED: a shared base function applied
  // to a per-agent template, sometimes several. Taking only the FIRST template
  // makes every prompt-reading check judge a fragment and report the shared half
  // as missing — noise that trains a reader to ignore the real findings.
  const prompt = templates
    .filter((t) => t.start > open && t.end <= close + 1)
    .map((t) => src.slice(t.start, t.end))
    .join('\n')
  // options object = last top-level {...} in the call
  let optsSrc = ''
  for (let i = callCode.length - 1; i >= 0; i--) {
    if (callCode[i] === '}') {
      let depth = 0
      let j = i
      for (; j >= 0; j--) {
        if (callCode[j] === '}') depth++
        else if (callCode[j] === '{') { depth--; if (depth === 0) break }
      }
      optsSrc = callSrc.slice(j, i + 1)
      break
    }
  }
  // The canonical wrapper takes the label POSITIONALLY — `spawn('kernel:door',
  // {...})`. Reading only `label:` from the options object reports every call
  // site as unlabelled and then names it by line number in a report someone has
  // to act on. Accept either form; only a call with neither is unlabelled.
  const positional = (callSrc.match(/^\(\s*[`'"]([^`'"]+)[`'"]\s*,/) || [])[1]
  const label =
    positional || (optsSrc.match(/label:\s*[`'"]([^`'"]*)/) || [])[1] || `agent@${lineOf(src, open)}`
  const labelled = Boolean(positional) || /\blabel\s*:/.test(optsSrc)
  // A forwarding call: no template-literal prompt and no options literal, just
  // identifiers passed through. That is a wrapper's own body, not a call site.
  if (!prompt && /^\(\s*[A-Za-z_$][\w$]*\s*(,\s*[A-Za-z_$][\w$]*\s*)*\)$/.test(callSrc.trim())) {
    forwarders++
    continue
  }
  agents.push({ line: lineOf(src, open), prompt, optsSrc, label, labelled, start: open })
}

report(INFO, 1, `${agents.length} agent() call sites${forwarders ? ` (+${forwarders} forwarding call${forwarders > 1 ? 's' : ''} inside a wrapper)` : ''}`)

// An extraction that comes up empty prints zero findings and exits 0, which is
// indistinguishable from a clean script — and is trusted more, because a tool
// said it. Every check below this line reads `agents`, so an inventory that
// missed the call sites silently disables all of them. Cross-check the count
// against a SECOND, independent population: the option keys that occur once per
// call site and nowhere else. `model:` is deliberately not among them — it also
// appears on `meta.phases[]` entries, so it cannot separate the two cases.
// `effort:` can: there is no `meta.phases[].effort`, and the guide requires the
// key on every call, so it counts the same population the inventory should.
const optionKeys = ['schema:', 'prompt:', 'phase:', 'effort:']
const keyFloor = Math.max(...optionKeys.map((k) => code.split(k).length - 1))
// Slack of 1: a wrapper's own forwarding call carries the same keys.
if (agents.length + forwarders < keyFloor - 1) {
  report(
    ERROR,
    1,
    `inventory implausible: ${agents.length} call site(s) found, but the script has ${keyFloor} ` +
      `agent-option key(s) — it almost certainly wraps the spawn call under a name this checker ` +
      `does not recognise, and EVERY check below (model, effort, schema, prompt size, ownership, ` +
      `prompt-vs-schema fields) is passing over an empty set. Rename the wrapper to \`spawn\`.`,
  )
}

// `effort` is the one option whose absence is invisible at runtime: the call
// still runs, at whatever the LAUNCHING SESSION was last set to. The same
// script then costs a multiple of itself depending on who ran it, and the
// pre-flight gate cannot read the run's cost off the script it reviewed — so
// it is an ERROR here, at the same level as a missing model. A wrong value is
// the other half: the enum is closed and a typo is rejected at the call,
// mid-run, after the phases before it have already been paid for.
const EFFORT_TIERS = ['low', 'medium', 'high', 'xhigh', 'max']

for (const a of agents) {
  for (const field of ['model', 'effort', 'label', 'schema', 'phase']) {
    if (field === 'label' && a.labelled) continue
    if (!new RegExp(`\\b${field}\\s*:`).test(a.optsSrc)) {
      const level = field === 'label' || field === 'phase' ? WARN : ERROR
      const why =
        field === 'effort'
          ? ' — it then inherits the launching session, so the script does not say what the run costs'
          : ''
      report(level, a.line, `agent ${a.label}: no \`${field}:\` in its options${why}`)
    }
  }
  const eff = (a.optsSrc.match(/\beffort\s*:\s*[`'"]([^`'"]*)/) || [])[1]
  if (eff !== undefined && !EFFORT_TIERS.includes(eff)) {
    report(ERROR, a.line, `agent ${a.label}: effort '${eff}' is not one of ${EFFORT_TIERS.join(', ')}`)
  }
  const schemaName = (a.optsSrc.match(/schema:\s*([A-Za-z_$][\w$]*)/) || [])[1]
  if (schemaName && schemaProps.has(schemaName)) {
    const mine = schemaProps.get(schemaName)
    // Only an INSTRUCTION to use a field counts ("report it in "x"", "goes into
    // "x""). A prompt that says the field does NOT exist is doing the right
    // thing and must not be flagged for saying so.
    for (const m of a.prompt.matchAll(/\b(?:in|into|under|to)\s+"([a-z][A-Za-z]{2,})"/g)) {
      const f = m[1]
      if (!allSchemaFields.has(f) || mine.has(f)) continue
      const lineStart = a.prompt.lastIndexOf('\n', m.index) + 1
      const lineEnd = a.prompt.indexOf('\n', m.index)
      const line = a.prompt.slice(lineStart, lineEnd === -1 ? undefined : lineEnd)
      if (/\bno\b|\bnot\b|never|loses it|does not/i.test(line)) continue
      report(ERROR, a.line, `agent ${a.label}: its prompt tells it to report in "${f}", but its schema ${schemaName} has no such field (it has: ${[...mine].join(', ')})`)
    }
  }
}

// --------------------------------- 5b. required fields nobody was told about --
//
// A schema shared by two agents is a contract shared by two agents. Recorded
// case: two guard booleans were added to a shared schema's `required` after ONE
// agent had been taught to observe them — the other agent sharing that schema
// then had to report the run's most important guard, which nothing had ever
// asked it to look at. Generic bookkeeping fields are exempt; a domain-specific
// required field that never appears in a consumer's prompt is the finding.

const GENERIC_REQUIRED = new Set(['files', 'summary', 'verified', 'contracts', 'findings', 'output'])
const schemaRequired = new Map()
for (const [name] of schemaProps) {
  const m = new RegExp(`(?:const|let|var)\\s+${name}\\s*=`).exec(code)
  if (!m) continue
  const brace = code.indexOf('{', m.index)
  const end = matchPair(code, brace, '{', '}')
  const inner = src.slice(brace + 1, end)
  // The FIRST `required` in a schema literal is usually the wrong one: a nested
  // `items` object declares its own, and a naive match reads THAT — so this
  // check spent its life reporting the field names of a list element (noise a
  // reader learns to skip) while never once looking at the schema's real
  // top-level `required`. Take the one at depth 0 of the literal.
  let depth = 0
  let topReq = null
  for (let i = 0; i < inner.length && topReq === null; i++) {
    const ch = inner[i]
    if (ch === '{' || ch === '[') depth++
    else if (ch === '}' || ch === ']') depth--
    else if (depth === 0 && inner.startsWith('required', i) && /required\s*:/.test(inner.slice(i, i + 12))) {
      const open = inner.indexOf('[', i)
      if (open !== -1) topReq = inner.slice(open + 1, inner.indexOf(']', open))
    }
  }
  if (topReq === null) continue
  schemaRequired.set(name, topReq.split(',').map((x) => x.trim().replace(/^['"`]|['"`]$/g, '')).filter(Boolean))
}
for (const a of agents) {
  const schemaName = (a.optsSrc.match(/schema:\s*([A-Za-z_$][\w$]*)/) || [])[1]
  for (const f of schemaRequired.get(schemaName) || []) {
    if (GENERIC_REQUIRED.has(f)) continue
    if (new RegExp(`\\b${f}\\b`).test(a.prompt)) continue
    report(WARN, a.line, `agent ${a.label}: ${schemaName}.required includes "${f}", but its prompt never mentions it — it must report a value it was never told how to obtain`)
  }
}

// ------------------------------- 5c. symbols named in prompts that do not exist --
//
// A prompt that names a test tells the agent that test exists; gate rounds have
// twice been spent on a test name that had drifted. Checked for the one class
// that is unambiguous and cheap: Go test function names. A tree with no
// *_test.go files simply skips this check.

try {
  const testFiles = []
  const walk = (dir, depth) => {
    if (depth > 6) return
    for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
      if (e.name === '.git' || e.name === 'node_modules' || e.name === '.wf') continue
      const full = path.join(dir, e.name)
      if (e.isDirectory()) walk(full, depth + 1)
      else if (e.name.endsWith('_test.go')) testFiles.push(full)
    }
  }
  walk(process.cwd(), 0)
  if (testFiles.length) {
    const haystack = testFiles.map((f) => fs.readFileSync(f, 'utf8')).join('\n')
    const seen = new Set()
    for (const a of agents) {
      for (const m of a.prompt.matchAll(/\bTest[A-Z][A-Za-z0-9_]{4,}/g)) {
        const name = m[0]
        const key = `${a.label}:${name}`
        if (seen.has(key)) continue
        seen.add(key)
        if (!haystack.includes(name)) {
          report(WARN, a.line, `agent ${a.label}: names ${name}, which no *_test.go in this tree declares — a drifted test name is an instruction the agent cannot follow`)
        }
      }
    }
  }
} catch { /* not a Go tree, or unreadable: this check simply does not apply */ }

// NOT IMPLEMENTED, deliberately, and the negative result is worth keeping: a
// "one rule, two wordings" check. THE failure mode of the last gate run was a
// rule restated in a second place and then updated in only one copy (5 of its 11
// blockers). A near-duplicate-line detector was written for it, calibrated, and
// then tested against the exact frozen script that round 2 blocked on — it found
// NOTHING there. The real signature is not "similar wording": it is two
// different sentences asserting opposite rules about one subject, which word
// overlap cannot see. It needs a reader, so it lives in
// ~/.claude/workflow-gate-checks.md as a fix protocol instead of here.

// ------------------------------------------------------------- 6. ownership --

const owners = new Map() // path -> [labels]
const PATH_RE = /(?:internal|cmd|scripts|pkg|src|test|tests)\/[\w./{}-]+\.\w+|\b(?:Makefile|README\.md|go\.mod|go\.sum|Dockerfile|compose\.yaml|docker-compose\.yml)\b/g
for (const a of agents) {
  const idx = a.prompt.search(/YOU OWN/i)
  if (idx === -1) continue
  const after = a.prompt.slice(idx)
  const lines = after.split('\n')
  const owned = []
  for (let i = 0; i < lines.length && i < 40; i++) {
    const l = lines[i]
    if (i > 0 && /^[A-Z][A-Z0-9 ,'()-]{8,}$/.test(l.trim())) break // a shouty heading ends the block
    if (/DO NOT|Do not|must not|may not|forbidden/i.test(l)) continue
    // An ownership entry STARTS with the path ("  internal/x/y.go — what for").
    // A path mentioned mid-sentence ("read internal/x/y.go for context") is
    // prose, not a claim of ownership, and counting it manufactures a collision.
    const trimmed = l.trim()
    const first = trimmed.match(PATH_RE)
    if (!first || !trimmed.startsWith(first[0])) continue
    // "cmd/app/main.go:129, internal/server/x_test.go:88" is a list of call
    // sites, not a claim of ownership. A file:line citation never owns anything.
    if (/^[\w./-]+\.\w+:\d+/.test(trimmed)) continue
    // An ownership entry is "path", "path — what for", "path (MODIFY, …)" or
    // "path, path2 — …". A path followed by a VERB is prose about that file
    // ("cmd/app/main.go calls it once"), and prose owns nothing.
    const rest = trimmed.slice(first[0].length)
    if (!/^(\s*$|\s*[—–\-(,:]|\s{2,})/.test(rest)) continue
    for (const m of trimmed.matchAll(PATH_RE)) {
      // Stop at the first prose word: "a.go, b.go — read c.go" owns a and b.
      const upto = trimmed.slice(0, m.index)
      if (/[—:]|\s(and|for|the|from|via|see|read)\s/i.test(upto)) break
      owned.push({ p: m[0], line: trimmed })
    }
  }
  for (const { p, line } of owned) {
    if (!owners.has(p)) owners.set(p, [])
    if (!owners.get(p).includes(a.label)) owners.get(p).push(a.label)
    const isNew = /\bNEW\b/i.test(line)
    if (!isNew && !fs.existsSync(path.join(process.cwd(), p)) && !p.includes('{')) {
      report(WARN, a.line, `agent ${a.label} owns ${p}, which does not exist and is not marked NEW`)
    }
  }
}
for (const [p, labels] of owners) {
  if (labels.length > 1) {
    report(ERROR, 1, `${p} is owned by ${labels.length} agents: ${labels.join(', ')} — exactly one agent may own a file`)
  }
}

// -------------------------------------------------------- 7. shell footguns --

const shellChecks = [
  {
    re: /git add -N\s+(?!\.)[^\n;]*&&/g,
    level: ERROR,
    msg: 'git add -N <paths> && … : a pathspec matching nothing exits 128 having added nothing, and && then suppresses the diff entirely — reviewers approve an empty diff. Use `git add -N . ; git diff HEAD -- <paths>`',
  },
  {
    re: /gofmt -l (?!\.)\S+\s*&&/g,
    level: ERROR,
    msg: 'gofmt -l X && … never fires: gofmt -l exits 0 whether or not it printed. Use test -z "$(gofmt -l .)"',
  },
  {
    re: /^\s{2,}git diff --stat(?![\s\S]{0,400}?git add -N \.)/gm,
    level: WARN,
    msg: 'git diff --stat shows nothing for untracked files — put `git add -N . ;` in front of it, or a new stray file is invisible to this check',
  },
  {
    re: /^\s{4,}(?:git|go|make|ls|docker|curl|test)\b[^\n]*<[^\n>]+>/gm,
    level: WARN,
    msg: 'a placeholder inside a fenced command line gets pasted into a shell verbatim — move it into the prose',
  },
]
for (const c of shellChecks) {
  for (const m of src.matchAll(c.re)) {
    // A prompt that EXPLAINS a footgun quotes it; a prompt that commits one
    // writes it as a command. Skip a match that sits inside a quoted phrase on
    // its own line — otherwise every warning about the trap trips the check.
    const lineStart = src.lastIndexOf('\n', m.index) + 1
    const before = src.slice(lineStart, m.index)
    if ((before.match(/"/g) || []).length % 2 === 1) continue
    report(c.level, lineOf(src, m.index), `${c.msg}\n        → ${m[0].trim().split('\n')[0].slice(0, 120)}`)
  }
}

// --------------------------------------------------------- 8. result safety --

{
  const par = (code.match(/\bparallel\(/g) || []).length
  const filt = (code.match(/\.filter\(Boolean\)/g) || []).length
  if (par && filt < par) {
    report(WARN, 1, `${par} parallel() calls but only ${filt} .filter(Boolean) — a thunk that throws resolves to null in the result array`)
  }
  const pipes = (code.match(/\bpipeline\(/g) || []).length
  if (par && !pipes) report(INFO, 1, `${par} parallel() barriers and no pipeline() — check each barrier is needed for cross-item context`)
  if (/\bwhile\s*\(/.test(code) && !/budget\.total/.test(code)) {
    report(ERROR, 1, 'a while loop with no budget.total guard can run to the 1000-agent cap')
  }
}

// ------------------------------------------------------------------ 9. cost --

{
  const expand = (text, depth = 0) => {
    if (depth > 3) return text
    return text.replace(/\$\{([A-Za-z_$][\w$]*)\}/g, (whole, name) => {
      const c = consts.get(name)
      if (!c || c.kind !== 'text') return whole
      return expand(src.slice(c.valueStart, c.end), depth + 1)
    })
  }
  const kb = (n) => `${(n / 1024).toFixed(1)} KB`
  let biggest = { label: '', size: 0 }
  for (const a of agents) {
    const size = expand(a.prompt).length
    if (size > biggest.size) biggest = { label: a.label, size }
    if (size > 40 * 1024) report(WARN, a.line, `agent ${a.label}: composed prompt is ${kb(size)} — over the ~40 KB mark, split its scope or move a blob to a file`)
  }
  report(INFO, 1, `largest composed prompt: ${biggest.label} at ${kb(biggest.size)}`)
  for (const [name, info] of consts) {
    if (info.kind !== 'text') continue
    const uses = (code.match(new RegExp(`\\$\\{${name}\\}`, 'g')) || []).length
    const size = info.end - info.valueStart
    if (uses >= 3 && size > 10 * 1024) {
      report(WARN, lineOf(src, info.start), `${name} is ${kb(size)} and inlined into ${uses} prompts (${kb(size * uses)} total) — over the guide's 10-20 KB per-blob rule`)
    }
  }
}

// ---------------------------------------------------------------- 10. print --

const order = { ERROR: 0, WARN: 1, INFO: 2 }
findings.sort((a, b) => order[a.level] - order[b.level] || a.line - b.line)
const counts = { ERROR: 0, WARN: 0, INFO: 0 }
for (const f of findings) counts[f.level]++

for (const f of findings) {
  console.log(`${f.level.padEnd(5)} ${String(f.line).padStart(5)}  ${f.msg}`)
}
console.log(`\n${path.basename(file)}: ${counts.ERROR} error(s), ${counts.WARN} warning(s), ${counts.INFO} note(s)`)
process.exit(counts.ERROR ? 1 : 0)
